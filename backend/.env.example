# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:your_password@localhost:5432/rice_mill_db

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Frontend URL allowed to call the API (comma-separated for several)
CORS_ORIGIN=http://localhost:3000

# First admin account, created by `npm run db:init`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@ricemill.local
ADMIN_PASSWORD=change_me_now
